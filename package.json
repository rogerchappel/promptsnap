{
  "name": "promptsnap",
  "version": "0.1.0",
  "description": "Local-first golden-file snapshot testing for prompts, skills, and agent instruction packs.",
  "type": "module",
  "bin": {
    "promptsnap": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && npm run test:compiled",
    "test:compiled": "node scripts/run-tests.mjs",
    "smoke": "bash scripts/smoke.sh",
    "package:smoke": "bash scripts/package-smoke.sh",
    "release:check": "npm run check && npm run build && npm test && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "prompt",
    "snapshot",
    "testing",
    "golden-files",
    "agents",
    "cli"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/promptsnap.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/promptsnap/issues"
  },
  "homepage": "https://github.com/rogerchappel/promptsnap#readme"
}
